# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=wcu_digital_campus
DATABASE_USER=wcu_user
DATABASE_PASSWORD=wcu_password_2024
DATABASE_URL=mysql://wcu_user:wcu_password_2024@localhost:3306/wcu_digital_campus

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=wcu_redis_2024
REDIS_URL=redis://:wcu_redis_2024@localhost:6379

# JWT Configuration
JWT_SECRET=wcu_jwt_secret_key_2024_very_secure_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Face Recognition API
FACE_API_KEY=your_face_recognition_api_key_here
FACE_API_URL=https://api.face-recognition-service.com

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@wcu.edu.et
SMTP_PASSWORD=your_email_password
FROM_EMAIL=noreply@wcu.edu.et
FROM_NAME=Wachemo University Digital Campus

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Ethiopian Banking Integration
BANK_API_URL=https://api.ethiopian-banks.com
BANK_API_KEY=your_bank_api_key
BANK_MERCHANT_ID=WCU_MERCHANT_001

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/wcu-backend.log

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=wcu-backups

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_API_KEY=your_analytics_key